# Copy to .env and adjust. The API reads these from the environment.
DATABASE_URL=postgres://chillcheck:chillcheck@localhost:5432/chillcheck?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
CORS_ORIGIN=http://localhost:5173

# --- Alerts (optional) ---
# The engine runs in-process and evaluates units on this interval.
ALERTS_ENABLED=true
ALERT_INTERVAL=1m
# Leave SMTP_HOST blank to log alerts instead of emailing them.
# For real email use SES SMTP / Mailgun / a Gmail app password (STARTTLS, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@chillcheck.local

# --- Billing (Stripe, optional) ---
# Leave STRIPE_SECRET_KEY blank to disable billing entirely (no gating, no trial limits).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects back to after checkout / portal (the frontend origin).
APP_BASE_URL=http://localhost:5173
